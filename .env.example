# Base URL of the HARP Go service, no trailing slash.
# Local:      http://localhost:8080
# Production: https://<your-cloud-run-service>.run.app
# Also read at build time by next.config.ts to allow-list this host for
# next/image (sponsor/track logos are fetched from it), so it must be set for
# `next build` too, not just at runtime.
HARP_API_BASE_URL=http://localhost:8080

# Must match PUBLIC_API_KEY on the Go service.
# Server-only — never prefix this with NEXT_PUBLIC_, it would ship to the browser.
HARP_PUBLIC_API_KEY=

# Canonical site origin for SEO metadata, no trailing slash. Optional locally;
# set it in Vercel Production so canonical/OG URLs point at the real domain.
# SITE_URL=https://example.hackutd.co
